rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidUserProfile(data) {
      return data.uid == request.auth.uid 
             && data.email is string && data.email.size() <= 256
             && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
             && (data.language == null || data.language in ['ar', 'en']);
    }

    function isValidWeightLog(data) {
      return data.userId == request.auth.uid
             && data.weight is number && data.weight > 0 && data.weight < 1000
             && data.date is timestamp;
    }

    function isValidWaterIntake(data) {
      return data.userId == request.auth.uid
             && data.amount is number && data.amount >= 0
             && data.date is string; // Format YYYY-MM-DD usually
    }

    // Rules for Collections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().updatedAt == request.time
                   && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'language', 'goal', 'preferences', 'updatedAt']);
      
      match /weightLogs/{logId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWeightLog(incoming());
        allow delete: if isOwner(userId);
      }

      match /plans/{planId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().createdAt == request.time;
      }

      match /water/{date} {
        allow list, get: if isOwner(userId);
        allow write: if isOwner(userId) && isValidWaterIntake(incoming());
      }

      match /progressPhotos/{photoId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().photoUrl is string;
      }
    }
  }
}
